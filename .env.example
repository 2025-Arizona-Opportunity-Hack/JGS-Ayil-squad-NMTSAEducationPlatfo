# ===========================================
# Content Portal - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Required variables are marked with [REQUIRED].
# Optional variables are marked with [OPTIONAL].
#
# One deployment serves ONE organization. To stand up another org on another
# domain, provision a separate instance — see docs/DEPLOYMENTS.md.

# --- Convex Backend [REQUIRED] ---
# Get these from https://dashboard.convex.dev after creating a project
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# --- Signed media URLs [REQUIRED] ---
# Any long random string, unique per deployment: openssl rand -hex 32
# Media URLs are HMAC-signed and FAIL CLOSED without this — non-public
# content stops serving entirely. Set via: npx convex env set MEDIA_URL_SECRET
MEDIA_URL_SECRET=generate-with-openssl-rand-hex-32

# --- Organization identity [OPTIONAL] ---
# Sender display name for the password-reset email, which is sent from a
# context with no database access. Everything else reads the organization name
# from siteSettings (set in the first-run setup wizard). Defaults to
# "Content Portal". Never leave another org's name here.
ORG_NAME=Your Organization

# --- Additional allowed origins [OPTIONAL] ---
# Comma-separated absolute origins allowed for CORS in addition to SITE_URL,
# e.g. an apex/www alias or a preview domain. Never use "*".
ALLOWED_ORIGINS=https://www.example.org,https://example.org

# --- Mock payments [OPTIONAL - DEV ONLY] ---
# Enables the mock checkout flow. NEVER set this in production: it lets a user
# complete their own order and unlock paid content without paying.
# ALLOW_MOCK_PAYMENTS=true

# --- Google OAuth [OPTIONAL - enables "Sign in with Google"] ---
# Create at https://console.cloud.google.com/apis/credentials
# See README.md for full setup instructions
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# --- Google Drive Integration [OPTIONAL - enables file import from Drive] ---
# Uses same Google Cloud project as OAuth above
# See README.md "Google Drive Integration" section for setup
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-google-api-key
VITE_GOOGLE_APP_ID=your-project-number

# --- Stripe Payments [OPTIONAL - enables paid content purchases] ---
# Create at https://dashboard.stripe.com/apikeys
# STRIPE_WEBHOOK_SECRET is REQUIRED if STRIPE_SECRET_KEY is set (security requirement)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# --- Email via Resend [OPTIONAL - enables email notifications] ---
# Create at https://resend.com
# RESEND_API_KEY is required for any email functionality (notifications, verification, invites)
# RESEND_DOMAIN should match your verified sending domain
RESEND_API_KEY=re_your-resend-api-key
RESEND_DOMAIN=your-domain.com

# --- SMS via Twilio [OPTIONAL - enables SMS notifications] ---
# Create at https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# --- Production Settings [REQUIRED for deployment] ---
# Your production frontend URL (used for CORS, email links, share links)
SITE_URL=https://your-production-domain.com
# Set to "production" to enable production behaviors
ENVIRONMENT=production
